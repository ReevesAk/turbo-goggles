# Copy to .env and fill in real values:  cp .env.example .env
# The placeholders below are enough to boot the app and run the test suite
# locally (docker compose) - external provider calls are mocked in tests.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-local-dev-only
# docker compose: postgis service. Running outside compose: point at your own PostGIS.
DATABASE_URL=postgis://picadailys:picadailys@db:5432/picadailys
REDIS_LOCATION=redis://redis:6379/0

# Payload encryption (base64). Real keys must match the mobile app's.
AES_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
AES_IV=MDAwMDAwMDAwMDAwMDAwMA==

# Central 9PSB accounts used for hybrid (points/cashback/card) payments
CENTRAL_OPERATIONAL_ACCOUNT=0000000000
CENTRAL_COLLECTION_ACCOUNT=0000000000

# --- 9PSB banking ---
NINE_PSB_BASEURL=https://example.invalid/9psb/
NINE_PSB_USERNAME=placeholder
NINE_PSB_PASSWORD=placeholder
NINE_PSB_WEBHOOK_USERNAME=placeholder
NINE_PSB_WEBHOOK_PASSWORD=placeholder

# --- 9PSB VAS (airtime, data, bills) ---
VAS_BASE_URL=https://example.invalid/vas/
VAS_USERNAME=placeholder
VAS_PASSWORD=placeholder

# --- Anchor BaaS (treasury app) ---
ANCHOR_API_KEY=placeholder
ANCHOR_OPS_ACCOUNT_ID=placeholder

# --- VTPass (alternate VAS provider) ---
VT_PASS_BASE_URL=https://example.invalid/vtpass/
VT_PASS_API_KEY=placeholder
VT_PASS_PUBLIC_KEY=placeholder
VT_PASS_SECRET_KEY=placeholder

# --- SafeHaven ---
SAFEHAVEN_CLIENT_ID=placeholder
SAFEHAVEN_COMPANY_URL=https://example.invalid
SAFEHAVEN_PRIVATE_KEY_PATH=./safehaven_private.pem

# --- Dojah (KYC) ---
APP_ID=placeholder
AUTHORIZATION=placeholder
DOJAH_BASE_URL=https://example.invalid/dojah
DOJAH_BBASE_URL=https://example.invalid/dojah
DOJAH_WIDGET_ID_AND_TOKEN=placeholder
DIGITAL_ADDREESS_VERIFICATION_LINK=https://example.invalid/address

# --- Paystack (cards) ---
PAYSTACK_SECRET_KEY=sk_test_placeholder

# --- YourNotify (SMS, email, WhatsApp) ---
YOURNOTIFY_BASE_URL=https://example.invalid/yournotify/
YOURNOTIFY_API_KEY=placeholder
YOURNOTIFY_WHATSAPP_OTP_TEMPLATE_ID=0

# --- Firebase (push). Set one of these; not needed to run tests. ---
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_PATH=

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# --- FlightsLogic ---
FLIGHTSLOGIC_BASE_URL=https://example.invalid/flights/
FLIGHTSLOGIC_USER_ID=placeholder
FLIGHTSLOGIC_PASSWORD=placeholder
FLIGHTSLOGIC_ACCESS=placeholder
FLIGHTSLOGIC_SERVER_IP=127.0.0.1

# --- Anthropic (AI task verification, AI support) ---
ANTHROPIC_API_KEY=
AI_AUTO_DECISION_ENABLED=True

# --- 9PSB OAuth client (banking/controllers.py) ---
CLIENT_ID=placeholder
CLIENT_SECRET=placeholder

# --- NextBee (legacy gamification SSO) ---
NEXTBEE_BASE_URL=https://example.invalid/nextbee/
NEXTBEE_GAMIFICATION_BASE_URL=https://example.invalid/nextbee-gamification/
NEXTBEE_ENVIRONMENT=sandbox
NEXTBEE_ADMIN_EMAIL=admin@example.com
NEXTBEE_ADVERTISER_ID=0
NEXTBEE_PROGRAM_ID=0
NEXTBEE_JWT_SECRET_KEY=placeholder
NEXTBEE_SSO_LOGIN_WIDGET_CONFIG=placeholder
NEXTBEE_SSO_REGISTER_WIDGET_CONFIG=placeholder

# --- Referral agents ---
REFERRAL_AGENT_DASHBOARD_URL=http://localhost:3000/agent
